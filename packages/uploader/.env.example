# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bosstalk-sounds
R2_PUBLIC_URL=https://cdn.bosstalk.io

# Algolia
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=

# Anthropic (for AI tag generation)
ANTHROPIC_API_KEY=

# Transcription: local | openai | assemblyai
TRANSCRIPTION_PROVIDER=local
TRANSCRIPTION_PYTHON_BIN=python

# OpenAI (only if TRANSCRIPTION_PROVIDER=openai)
OPENAI_API_KEY=

# AssemblyAI (only if TRANSCRIPTION_PROVIDER=assemblyai)
ASSEMBLYAI_API_KEY=

# Sound source mode:
#   wow-install  — read directly from a local WoW installation (recommended)
#   filesystem   — read from a pre-extracted sounds directory (fallback)
#   casc-remote  — fetch new files from Blizzard CDN (patch detection only)
SOURCE_MODE=wow-install

# Path to your WoW installation root (used when SOURCE_MODE=wow-install)
# Point at the directory that contains .build.info (the launcher root, NOT _retail_).
# Windows: C:\Program Files (x86)\World of Warcraft
# Mac:     /Applications/World of Warcraft
WOW_INSTALL_PATH=C:\Program Files (x86)\World of Warcraft

# Directory for caching the community listfile and CASC working files.
# Defaults to ~/.bosstalk/cache if not set. Should be outside the git repo.
WOW_CACHE_DIR=C:\Users\Jeff\.bosstalk\cache

# Path to pre-extracted sounds (only used when SOURCE_MODE=filesystem)
SOUNDS_ROOT_PATH=C:\WoWExtract\sounds

# Scheduler cron expression (default: 3am daily)
# Note: if using Windows Task Scheduler (register-task.ps1), this is ignored —
# the schedule is set in the task itself. This cron is used when running as a
# long-lived process (node dist/index.js without --run-once).
SCHEDULER_CRON=0 3 * * *

# Set true to skip transcription (useful for testing the upload/index pipeline quickly)
SKIP_TRANSCRIPTION=false

# Log level: error | warn | info | debug
LOG_LEVEL=info
