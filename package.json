{
  "name": "bosstalk-root",
  "version": "3.0.0",
  "description": "BossTalk monorepo — WoW sounds in Discord",
  "author": "Jeffrey Slentz",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/bot",
    "build": "npm run build --workspaces --if-present",
    "deploy-commands": "npm run deploy-commands --workspace=packages/bot"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "puppeteer@23.11.1": true
  }
}
