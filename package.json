{
  "name": "bosstalk-root",
  "version": "3.0.0",
  "description": "BossTalk monorepo — WoW sounds in Discord",
  "author": "Jeffrey Slentz",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/bot",
    "bot:dev-win": "set NODE_ENV=dev && node index.js",
    "bot:prod-win": "set NODE_ENV=prod && node index.js",
    "bot:dev-linux": "export NODE_ENV=dev && node index.js",
    "bot:prod-linux": "export NODE_ENV=prod && node index.js",
    "bot:deploy-commands-linux": "export NODE_ENV=prod && node src/deploy_commands.js",
    "bot:deploy-commands-windows": "set NODE_ENV=prod && node src/deploy_commands.js"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.16.0",
    "discord.js": "^14.9.0",
    "ffmpeg-static": "^5.2.0",
    "fuse.js": "^6.6.2",
    "tweetnacl": "^1.0.3",
    "winston": "^3.8.2"
  }
}
